i, malíku a patě.","Hlavu vytáhněte ke stropu, ramena stáhněte od uší.","Mírně podsaďte pánev a napřimte bederní páteř.","Prodechněte se do spodních žeber a třísel.","Na druhou stranu se otočte, ať je přední noha zase blíž k telefonu."],"tips":[{"t":"Koleno přední nohy je nad kotníkem, nejde před špičku.","check":true},{"t":"Trup jde ve výpadu do mírného předklonu, nezůstává svisle.","check":true},{"t":"Bedra se nadměrně neprohýbají.","check":true},{"t":"Pohyb vychází z kyčelních kloubů, ne z beder.","check":true},{"t":"Hrudní páteř se nehrbí.","check":true},{"t":"Hlava v prodloužení páteře, ramena od uší.","check":true},{"t":"Pata přední nohy zůstává na podložce.","check":true},{"t":"Koleno přední nohy je stabilní a neuhýbá do stran (z boku to kamera nevidí).","check":false},{"t":"Trojí opora chodidla: pod palcem, malíkem a patou.","check":false},{"t":"Ve výpadu výdrž na nádech a výdech.","check":false},{"t":"Aktivní nitrobřišní tlak, dech do spodních žeber a třísel.","check":false}],"texts":{"shin":{"hi":"Koleno nad kotníkem."},"trunk":{"lo":"Trup nakloňte mírně vpřed."},"heel":{"hi":"Pata přední nohy zůstává na podložce."}},"reminders":[{"every":12,"text":"Dýchejte do celého trupu a třísel."},{"every":20,"text":"Ve výpadu se nadechněte a vydechněte."}],"video":"media/vypady-vzad.mp4","settings":{"joints":{"sh":{"on":false},"el":{"on":false},"lumbar":{"tol":15},"thor":{"tol":15},"head":{"tol":12},"heel":{"tol":20}},"tempo":{"on":false},"depth":{"on":true,"tol":20}},"priority":["lumbar","shin","trunk","hip","thor","head","shrug","heel","knee","toe","sh","el"]}